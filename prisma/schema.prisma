// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SUBSCRIPTION
}

model Product {
  id               String      @id @db.Uuid
  name             String
  type             ProductType
  unitPriceMinor   BigInt      @map("unit_price_minor")
  subscriptionDays Int?        @map("subscription_days")
  digitalMetadata  Json?       @map("digital_metadata") @db.JsonB
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  inventory Inventory?

  @@map("products")
}

model Inventory {
  productId String   @id @map("product_id") @db.Uuid
  available Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventories")
}

// INFO: Orders

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  FAILED
}

enum OrderItemStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model Order {
  id          String      @id @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  status      OrderStatus @default(PENDING_PAYMENT)
  totalMinor  BigInt      @map("total_minor")
  currency    String      @db.Char(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  items       OrderItem[]
  outbox      OrderOutbox[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String          @id @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  productType    ProductType     @map("product_type")
  quantity       Int
  unitPriceMinor BigInt          @map("unit_price_minor")
  status         OrderItemStatus @default(PENDING)
  attempts       Int             @default(0)
  claimedBy      String?         @map("claimed_by")
  leaseExpiresAt DateTime?       @map("lease_expires_at") @db.Timestamptz
  lastError      String?         @map("last_error")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([status, leaseExpiresAt])
  @@map("order_items")
}

model OrdersIdempotencyKey {
  idempotencyKey String            @id @map("idempotency_key")
  customerId     String            @map("customer_id") @db.Uuid
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseCode   Int?              @map("response_code")
  responseBody   Json?             @map("response_body") @db.JsonB
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([customerId])
  @@index([expiresAt])
  @@map("orders_idempotency_keys")
}

model OrderOutbox {
  id            String       @id @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  routingKey    String       @map("routing_key")
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  publishedAt     DateTime   @map("published_at") @db.Timestamptz

  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([orderId])
  @@map("orders_outbox")
}
